TEABLE_API_KEY=
TEABLE_BASE_URL=https://teable.hirschfeld.at
CRM_PASSWORD=
CRM_API_KEY=
SESSION_SECRET=
TRUST_PROXY_USER=0
OPENROUTER_API_KEY=

# Der Login-Rate-Limiter (src/routes/login/+page.server.ts) schlüsselt nach
# getClientAddress(). Hinter einem Reverse-Proxy liefert das ohne
# ADDRESS_HEADER (und ggf. XFF_DEPTH) für jeden Aufrufer denselben Wert — der
# Limiter ist dann faktisch global: fehlgeschlagene Login-Versuche einer
# Person sperren alle aus, auch Felix. Erst setzen, wenn der Reverse-Proxy
# (Authelia) vor der Live-Instanz das passende Adress-Header nachweislich
# durchreicht — siehe adapter-node-Doku zu ADDRESS_HEADER/XFF_DEPTH.
ADDRESS_HEADER=
XFF_DEPTH=
